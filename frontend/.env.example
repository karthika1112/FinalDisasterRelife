# ── Copy these into Vercel → Settings → Environment Variables ─

# Your Railway backend URL (no trailing slash)
# Example: https://disaster-relief-backend.up.railway.app/api
REACT_APP_API_URL=https://your-backend.up.railway.app/api

# Your Railway backend base URL (for image uploads)
# Example: https://disaster-relief-backend.up.railway.app
REACT_APP_BASE_URL=https://your-backend.up.railway.app
