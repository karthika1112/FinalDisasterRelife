# ── Copy these into Railway → Variables tab ───────────────────

PORT=5000
NODE_ENV=production

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<user>:<pass>@cluster0.xxxxx.mongodb.net/disaster_relief?retryWrites=true&w=majority

# JWT — use a long random string in production
JWT_SECRET=replace_with_long_random_secret
JWT_EXPIRE=7d

# Your Vercel frontend URL (no trailing slash)
# Example: https://disaster-relief.vercel.app
FRONTEND_URL=https://your-app.vercel.app
